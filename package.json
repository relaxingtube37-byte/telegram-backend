{
  "name": "telegram-backend",
  "version": "1.0.0",
  "description": "Telegram Bot, WebApp Backend & Channel Auto-Publisher for AI Tennis Predictions",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:prod": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "start:prod": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "tsx src/test_admin_web_auth.ts && tsx src/test_backend_full.ts",
    "build:frozen-dataset": "tsx src/scripts/buildFrozenDatasetFromDb.ts",
    "build:frozen-dataset:quick": "tsx src/scripts/buildFrozenDatasetFromDb.ts --limit 5000",
    "test:ingestion": "tsx src/scripts/testHistoricalUnification.ts",
    "test:sentinel-leakage": "tsx src/scripts/runSentinelLeakageTest.ts",
    "audit:data-quality": "tsx src/scripts/auditGeneratedDataQuality.ts",
    "test:aggregate-quality": "tsx src/scripts/testPhase2AggregateQuality.ts",
    "bulk:list-cohort": "tsx src/scripts/listBulkFetchCohort.ts",
    "bulk:fetch-match-bundles": "tsx src/scripts/runBulkMatchBundleFetch.ts",
    "bulk:probe-samples": "tsx src/scripts/probeBulkApiSamples.ts",
    "bulk:probe-coverage": "tsx src/scripts/probeBulkApiCoverage.ts",
    "bulk:list-player-history": "tsx src/scripts/listBulkPlayerHistoryPlan.ts",
    "bulk:fetch-player-history": "tsx src/scripts/runBulkPlayerHistoryFetch.ts",
    "bulk:ui": "tsx src/bulk-fetch-ui/server.ts",
    "bulk:ui:free-port": "tsx src/scripts/freeBulkUiPort.ts",
    "bulk:ui:restart": "tsx src/scripts/freeBulkUiPort.ts && tsx src/bulk-fetch-ui/server.ts",
    "bulk:test-bundles": "tsx src/scripts/testBulkBundlesPhase.ts"
  },
  "dependencies": {
    "@types/sharp": "^0.31.1",
    "better-sqlite3": "^11.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "grammy": "^1.35.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
